{
  "name": "krishiscan",
  "version": "0.1.0",
  "private": true,
  "description": "AI-driven crop disease detection and outbreak prediction for Indian farmers (MERN)",
  "workspaces": [
    "server",
    "client"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c green,cyan \"npm:dev -w server\" \"npm:dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "seed": "npm run seed -w server --",
    "test": "npm test -w server && npm test -w client",
    "reset-password": "npm run reset-password -w server --"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
