# Copy to server/.env and fill in. Every value here is optional in development.

NODE_ENV=development
PORT=5000

# Leave empty in development to use a throwaway in-memory MongoDB (auto-seeded with demo data).
# Production: a MongoDB Atlas connection string, e.g.
# MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/krishiscan
MONGO_URI=

# Required in production: at least 32 random characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7

# Set to true behind a reverse proxy (Render, Railway) so rate limiting sees real client IPs.
TRUST_PROXY=false
# Only if the React app is hosted on a different origin than this API (not the default setup).
CLIENT_ORIGIN=

# local = server disk (wiped on every deploy on most free hosts); cloudinary = persistent.
STORAGE_DRIVER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# local = run the pinned ONNX models in-process (downloaded once, ~32 MB total).
# mock  = deterministic fake classifier for UI work without the models.
INFERENCE_DRIVER=local
MODEL_CACHE_DIR=
# 0 = let onnxruntime decide. Use 1 on tiny shared-CPU hosts.
ORT_THREADS=0
CONFIDENCE_HIGH=0.7

MAX_UPLOAD_MB=8
